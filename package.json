{
  "name": "testudoq",
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.{js,mjs}\" \"test/**/*.{js,mjs}\"",
    "test:unit": "cross-env NODE_ENV=test jest",
    "test:e2e": "cross-env NODE_ENV=test jest test/e2e --runInBand",
    "pretest": "npm run lint && rimraf testem/compiled",
    "test": "npm run test:unit && npm run test:e2e && testem ci -R dot",
    "pretest-browser": "npm run pretest",
    "test-browser": "testem",
    "pretest-chrome": "npm run pretest",
    "test-chrome": "testem -l Chrome",
    "sourcemap": "sourcemap-lookup",
    "clean": "rimraf pack",
    "prepack-extension": "npm run clean && copyfiles -u 1 template/**/* pack",
    "pack-extension": "webpack --config webpack.config.mjs",
    "postpack-extension": "node --experimental-modules clean-duplicates.mjs",
    "validate-build": "node validate-build.mjs",
    "copy-main-files": "node copy-files.mjs",
    "copy-lib-files": "node copy-lib-files.mjs",
    "fix-imports": "node fix-imports.mjs",
    "build-min-obs-extension": "npm run prepack-extension && npm run pack-extension && npm run copy-main-files && npm run copy-lib-files && npm run fix-imports && npm run validate-build && npm run post-build-min-obs",
    "build-extension": "npm run prepack-extension && npm run pack-extension && npm run copy-main-files && npm run copy-lib-files && npm run fix-imports && npm run postpack-extension && npm run validate-build",
    "ff-build": "web-ext build",
    "post-build-min-obs": "node post-build-min-obs",
    "cleanup": "node --experimental-modules clean-duplicates.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/preset-env": "^7.24.0",
    "@jest/globals": "^29.7.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "csp-html-webpack-plugin": "^5.1.0",
    "eslint": "^8.55.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-crockford": "^2.0.0",
    "eslint-config-defaults": "^9.0.0",
    "eslint-plugin-jest": "^27.9.0",
    "fs-readdir-recursive": "^1.1.0",
    "html-loader": "^5.0.0",
    "jasmine": "^5.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "sourcemap-lookup": "0.0.5",
    "testem": "^3.11.0",
    "uglify-js": "^3.17.4",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-middleware": "^7.0.0"
  },
  "dependencies": {
    "emoji-regex": "^10.3.0",
    "fs-extra": "^11.2.0",
    "gremlins.js": "github:marmelab/gremlins.js#master",
    "javascript-obfuscator": "^4.1.0",
    "ncp": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^5.0.5",
    "testudoq": "file:"
  }
}
