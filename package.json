{
  "name": "testudoq",
  "version": "2.0.4-dev",
  "scripts": {
    "lint": "eslint src test",
    "pretest": "npm run lint && rimraf testem/compiled",
    "test": "testem ci -R dot",
    "pretest-browser": "npm run pretest",
    "test-browser": "testem",
    "pretest-chrome": "npm run pretest",
    "test-chrome": "testem -l Chrome",
    "sourcemap": "sourcemap-lookup",
    "clean": "rimraf packages/dev-pack packages/prd-pack",
    "prepack-dev": "npm run clean",
    "prepack-prod": "npm run clean",
    "version:dev": "node updateVersion.js",
    "version:prod": "node updateVersion.js --prod",
    "build:dev": "npm run version:dev && webpack --config webpack.dev.js",
    "build:prod": "npm run version:prod && webpack --config webpack.prod.js",
    "watch": "webpack --config webpack.dev.js --watch",
    "build-min-obs-extension": "npm run build:prod && npm run post-build-min-obs",
    "build-extension": "npm run build:dev",
    "ff-build": "web-ext build",
    "post-build-min-obs": "node post-build-min-obs"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "csp-html-webpack-plugin": "^5.1.0",
    "eslint": "^8.55.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-crockford": "^2.0.0",
    "eslint-config-defaults": "^9.0.0",
    "eslint-plugin-jest": "^27.9.0",
    "fs-readdir-recursive": "^1.1.0",
    "html-loader": "^5.0.0",
    "jasmine": "^5.1.0",
    "jest": "^29.7.0",
    "sourcemap-lookup": "0.0.5",
    "terser-webpack-plugin": "^5.3.10",
    "testem": "^3.11.0",
    "uglify-js": "^3.17.4",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-middleware": "^7.0.0",
    "webpack-merge": "^5.10.0"
  },
  "dependencies": {
    "emoji-regex": "^10.3.0",
    "fs-extra": "^11.2.0",
    "gremlins.js": "github:marmelab/gremlins.js#master",
    "javascript-obfuscator": "^4.1.0",
    "ncp": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^5.0.5",
    "testudoq": "file:"
  }
}
