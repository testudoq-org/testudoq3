{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-dev",
      "type": "npm",
      "script": "build:dev",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Build the development version of the extension"
    },
    {
      "label": "Build Extension for Firefox",
      "type": "shell",
      "command": "web-ext",
      "args": [
        "build",
        "--source-dir",
        "packages/dev-pack",
        "--artifacts-dir",
        "web-ext-artifacts"
      ],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
