{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Development Firefox Extension Pack",
      "type": "firefox",
      "request": "launch",
      "reAttach": true,
      "url": "https://xanpho.x10.bz/simple-input.html",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "webpack:///template/*": "${webRoot}/template/*",
        "webpack:///src/lib/*": "${webRoot}/src/lib/*",
        "webpack:///src/main/*": "${webRoot}/src/main/*"
      },
      "sourceMaps": true,
      "trace": true,
      "timeout": 30000,
      "firefoxExecutable": "D:\\Program Files\\Mozilla Firefox\\firefox.exe",
      "runtimeArgs": [
        "--disable-extensions-except=${workspaceFolder}/packages/dev-pack",
        "--load-extension=${workspaceFolder}/packages/dev-pack",
        "--user-data-dir=${env:CHROME_PROFILE_PATH}",
        "-start-debugger-server",
        "-jsdebugger",
        "-foreground"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/dev-pack/**/*.js"
      ],
      "skipFiles": [
        "${workspaceFolder}/node_modules/**",
        "${workspaceFolder}/**/*.min.js"
      ]
    },
    {
      "name": "Launch Development Chrome Extension Pack",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "build-dev",
      "url": "https://testudo.co.nz/sbt/simple-input.html",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "webpack:///template/*": "${webRoot}/template/*",
        "webpack:///src/lib/*": "${webRoot}/src/lib/*",
        "webpack:///src/main/*": "${webRoot}/src/main/*"
      },
      "sourceMaps": true,
      "trace": true,
      "timeout": 30000,
      "runtimeArgs": [
        "--disable-extensions-except=${workspaceFolder}/packages/dev-pack",
        "--load-extension=${workspaceFolder}/packages/dev-pack",
        "--user-data-dir=${env:CHROME_PROFILE_PATH}"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/dev-pack/**/*.js"
      ],
      "userDataDir": false,
      "skipFiles": [
        "${workspaceFolder}/node_modules/**",
        "${workspaceFolder}/**/*.min.js"
      ]
    }
  ]
}
